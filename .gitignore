# Ignore everything by default
*

# But allow .ipynb files (notebooks)
!*.ipynb

# Allow backend (FastAPI app)
!backend/
!backend/**

# Don't ignore .gitignore itself
!.gitignore

# Ignore specific file types and directories
.DS_Store
*.md
*.json
*.csv
*.txt
data/
experiments/
indices/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/

# Re-allow backend docs and config (overrides *.md, *.txt above)
!backend/**/*.md
!backend/**/*.txt

